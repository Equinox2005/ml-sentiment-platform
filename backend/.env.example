# Copy to backend/.env and start the API with: uvicorn main:app --env-file .env
# Every setting is optional.

# Folder with sentiment_model.pkl, tfidf_vectorizer.pkl and metadata.json (default: ../model)
MODEL_DIR=../model

# Comma-separated origins allowed to call the API from a browser (default: *)
CORS_ORIGINS=http://localhost:3000
